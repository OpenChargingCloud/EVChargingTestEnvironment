<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>cloud.charging.open.TestEnvironment.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!--
    What this environment is for, in test form: two of the components at
    once, talking to each other. A single-component repository can only
    ever test itself against a stub - the CSMS repository has no EMSP
    beside it and the EMSP repository has no CSMS - so the tests that need
    both real ends live here, where both are checked out.

    The frontends are not needed to answer an OCPI request, so nothing here
    builds them; SkipFrontendBuild reuses whatever is in dist/, and an
    assembly without a web interface still serves its JSON API.

    The local controller and the charging station are here for OCPP over
    SSH: a real station dialling a real controller, which neither of their
    repositories can do - each has only a stub of the other. The node's test
    kit hands out the ports, so that these tests and the components' own
    never reach for the same one; it is on NUnit 5, and so is this project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\libs\CSMS\CSMS\CSMS.csproj" />
    <ProjectReference Include="..\libs\EMSP\EMSP\EMSP.csproj" />
    <ProjectReference Include="..\libs\LocalController\LocalController\LocalController.csproj" />
    <ProjectReference Include="..\libs\ChargingStation\ChargingStation\ChargingStation.csproj" />
    <ProjectReference Include="..\libs\Hermod\Hermod\Hermod.csproj" />
    <ProjectReference Include="..\libs\WWCP_OCPI\WWCP_OCPI_Common\WWCP_OCPI_Common.csproj" />
    <ProjectReference Include="..\libs\WWCP_Node\WWCP_Node_TestKit\WWCP_Node_TestKit.csproj" />
  </ItemGroup>

</Project>
